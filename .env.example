# ==========================================
# A.R.E.S. Configuration Template
# ==========================================

# LLM Provider: 'ollama', 'groq', 'gemini', or 'openai'
ARES_LLM_PROVIDER=ollama

# Local Ollama Settings (Privacy First)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Remote API Settings (Optional fast cloud fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Text-to-Speech (Edge-TTS)
TTS_ENABLED=true
# Voice options: en-US-ChristopherNeural (Authoritative / Jarvis), en-US-GuyNeural, en-GB-RyanNeural, bn-BD-PradeepNeural
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# Audio Player (macOS default: /usr/bin/afplay)
AUDIO_PLAYER=/usr/bin/afplay
